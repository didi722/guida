# Copia questo file in `.env` e compila i valori. Tutte le variabili sono facoltative in sviluppo.
#
# Molte di queste impostazioni (contatti, regole di prenotazione, buoni regalo, recensioni, dati fiscali) si
# cambiano anche dal pannello, in Sito › Impostazioni: qui valgono come VALORI PREDEFINITI e, se un campo è stato
# cambiato dal pannello, vince il pannello. Restano SOLO qui: password del pannello, chiavi di Stripe, posta (SMTP),
# PEC, indirizzo del sito e cartella dei dati.

# ───── Sito ─────
PORT=3000
# URL pubblico (usato nei link delle email, nel sitemap e per Stripe). In produzione: https://tuodominio.it
BASE_URL=http://localhost:3000
NODE_ENV=development            # in produzione: production
# Dietro un reverse proxy (nginx, Caddy, Render, Fly…) lascia true in produzione
# TRUST_PROXY=true
# Cartella dei dati (database SQLite, email in uscita simulate). In produzione: un volume persistente.
# DATA_DIR=/var/lib/guida

# ───── Chi sei (footer, email, pagine legali) ─────
SITE_NAME=Davide Tomio
LEGAL_NAME=Davide Tomio
CONTACT_EMAIL=info@example.com
# CONTACT_PHONE=+39 333 1234567
# CONTACT_WHATSAPP=393331234567     # solo cifre, con prefisso internazionale
# INSTAGRAM_URL=https://instagram.com/davide.tomio
# Da compilare quando apri la partita IVA:
# VAT_NUMBER=IT00000000000
# GUIDE_LICENSE=Guida turistica abilitata n. … (italiano, inglese, spagnolo, giapponese)
# LEGAL_ADDRESS=Via … , Venezia

# ───── Sicurezza ─────
# Password del pannello /admin (obbligatoria in produzione, altrimenti l'admin è disattivato).
# Scrivila senza virgolette. In sviluppo, se la lasci vuota, vale «admin». Dopo ogni modifica riavvia il sito.
ADMIN_PASSWORD=
# Stringa casuale lunga (≥ 32 caratteri) per firmare i cookie di sessione. Obbligatoria in produzione.
#   genera con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ───── Pagamenti con carta (Stripe) ─────
# Senza STRIPE_SECRET_KEY, in sviluppo si usa una pagina di pagamento SIMULATA (demo).
# In produzione senza chiave i pagamenti con carta sono disattivati (resta "paga sul posto" / fattura).
STRIPE_SECRET_KEY=
# Segreto del webhook (Stripe → Developers → Webhooks → endpoint https://tuodominio.it/api/stripe/webhook,
# eventi: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired)
STRIPE_WEBHOOK_SECRET=

# ───── Email (SMTP) ─────
# Senza SMTP le email NON partono: vengono salvate in data/outbox/ (utile in sviluppo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=false                 # true per la porta 465
MAIL_FROM=Davide Tomio <info@example.com>
# Dove arrivano gli avvisi di nuove prenotazioni / richieste partner (default: CONTACT_EMAIL)
# NOTIFY_EMAIL=

# ───── Regole di prenotazione ─────
B2C_FREE_CANCEL_HOURS=48          # clienti privati: cancellazione gratuita fino a N ore prima
B2B_FREE_CANCEL_HOURS=72          # agenzie/DMC (si può cambiare per singolo partner dall'admin)
B2C_MIN_NOTICE_HOURS=24           # preavviso minimo per prenotare
B2B_MIN_NOTICE_HOURS=12
MAX_ADVANCE_DAYS=365
BUFFER_MIN=30                     # pausa tra due servizi
SLOT_STEP_MIN=30                  # passo degli orari per i servizi a orario libero
HOLD_MINUTES=35                   # per quanto si tiene lo slot durante il pagamento
# Pagamento il giorno del tour (contanti/POS) ai clienti privati. DISATTIVATO di default: con le prenotazioni online
# sono più frequenti i «no show» e le prenotazioni fasulle che bloccano il calendario di una guida sola, e chi prenota
# da lontano preferisce pagare subito. Se lo attivi, abilita comunque il pagamento per singolo tour (nel pannello: Sito › Tour).
ALLOW_PAY_ON_SITE=false
# «Pre-apertura» (prima di aprire la partita IVA): fino a questa data (AAAA-MM-GG) il sito accetta prenotazioni solo per le date
# da quel giorno in poi e NON incassa online (privati: si paga di persona; agenzie: a fattura o con opzione). Vuoto = incassi sempre attivi.
# Si cambia anche dal pannello: Sito › Impostazioni › Regole di prenotazione › Incassi dal.
# PAYMENTS_FROM=2027-01-04

# ───── Opzioni per le agenzie (data trattenuta senza pagare) ─────
# La durata dipende da quanto manca al tour: la tabella si modifica dal pannello (Sito › Impostazioni › Opzioni per le agenzie).
# OPTIONS_ENABLED=true
# OPTION_MIN_RELEASE_HOURS=48       # l'opzione scade almeno così tante ore prima del servizio
# OPTION_MAX_ACTIVE=5               # opzioni aperte insieme per agenzia (0 = nessun limite)
# OPTION_REMINDER_HOURS=24          # promemoria all'agenzia prima della scadenza (0 = nessuno)

# ───── Promemoria prima del tour ─────
# La sera prima (ore 18 di Venezia) i clienti privati ricevono un'email con orario, punto d'incontro e come contattarti.
# REMINDERS_ENABLED=true
# REMINDER_SEND_HOUR=18

# ───── Recensioni dopo il tour ─────
# Il giorno dopo il servizio (ore 10 di Venezia) parte una sola email ai clienti privati con i link per recensire.
# REVIEWS_ENABLED=true
# REVIEW_URL=https://g.page/r/…/review             # link «scrivi una recensione» del Profilo dell'attività su Google
# REVIEW_URL_TRIPADVISOR=
# REVIEWS_PAGE_URL=https://g.page/r/…                # pagina con tutte le recensioni (profilo Google/Tripadvisor): «Leggi tutte le recensioni» accanto ai commenti sul sito
# REVIEW_SEND_HOUR=10

# ───── Buoni regalo e programmi di più giorni ─────
# GIFT_VALIDITY_MONTHS=24
# GIFT_MIN_EUR=20
# GIFT_MAX_EUR=1000
# PROGRAM_DEPOSIT_PERCENT=30                       # acconto proposto nei preventivi
# PROGRAM_VALIDITY_DAYS=7                          # validità predefinita di una proposta

# ───── Traduzione automatica dei commenti sul sito (facoltativa) ─────
# I commenti che scegli di mostrare vengono tradotti nella lingua di chi guarda, con «Vedi originale». Senza chiave: spenta.
# TRANSLATE_PROVIDER=deepl          # deepl (piano gratuito: 500.000 caratteri al mese) oppure google
# TRANSLATE_API_KEY=

# ───── «Aggiungi al wallet» del telefono (facoltativo, solo clienti privati) ─────
# Ogni piattaforma si accende quando ha tutti i dati; vedi docs/GUIDA.md (sezione 18) per i passaggi.
# Google Wallet: Issuer ID dalla Google Pay & Wallet Console + file JSON dell'account di servizio
# GOOGLE_WALLET_ISSUER_ID=3388000000012345678
# GOOGLE_WALLET_KEY_FILE=/percorso/account-di-servizio.json
#   (in alternativa al file: GOOGLE_WALLET_SERVICE_ACCOUNT=nome@progetto.iam.gserviceaccount.com e GOOGLE_WALLET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…")
# Apple Wallet: Pass Type ID, Team ID, certificato e chiave in PEM e certificato intermedio Apple (WWDR)
# APPLE_WALLET_PASS_TYPE_ID=pass.it.tuodominio.prenotazione
# APPLE_WALLET_TEAM_ID=ABCDE12345
# APPLE_WALLET_CERT_FILE=/percorso/pass.pem
# APPLE_WALLET_KEY_FILE=/percorso/pass.key
# APPLE_WALLET_KEY_PASSPHRASE=
# APPLE_WALLET_WWDR_FILE=/percorso/wwdr.pem

# ───── Calendario personale (Google Calendar, iCloud, Outlook…) ─────
# Si collega dal pannello (Disponibilità → Calendari collegati) con l'«indirizzo segreto in formato iCal».
# CALENDAR_SYNC_MINUTES=10                         # ogni quanto il sito rilegge il calendario
# CALENDAR_FRESH_SECONDS=120                       # prima di confermare una prenotazione si riallinea se i dati sono più vecchi di così

# ───── Fatturazione elettronica (FatturaPA) ─────
# FATTI CONFERMARE OGNI VOCE DAL COMMERCIALISTA prima della prima fattura. Partita IVA: VAT_NUMBER (sopra).
# FISCAL_CODE=RSSMRA80A01H501U
# INVOICE_FIRST_NAME=Mario                         # se emetti come persona fisica…
# INVOICE_LAST_NAME=Rossi
# INVOICE_NAME=                                    # …oppure la denominazione, se sei una società
# INVOICE_ADDRESS=Calle del Esempio 1
# INVOICE_ZIP=30100
# INVOICE_CITY=Venezia
# INVOICE_PROVINCE=VE
# INVOICE_REGIME=RF19                              # RF19 forfettario · RF01 ordinario · RF02 minimi
# INVOICE_VAT_RATE=0                               # 0 nel forfettario; 22 nel regime ordinario
# INVOICE_NATURE=N2.2                              # natura dell'operazione quando l'IVA è zero (forfettario: N2.2)
# INVOICE_PRICES_INCLUDE_VAT_B2C=true              # i prezzi ai privati comprendono l'IVA (conta solo con IVA > 0)
# INVOICE_PRICES_INCLUDE_VAT_B2B=false             # le tariffe ai partner sono al netto dell'IVA
# INVOICE_BOLLO=auto                               # auto = bollo virtuale 2 € oltre 77,47 € sulle operazioni senza IVA; never = mai
# INVOICE_CONTRIBUTION_PERCENT=0                   # rivalsa INPS (es. 4) proposta nelle fatture alle imprese
# INVOICE_WITHHOLDING_PERCENT=0                    # ritenuta d'acconto (es. 20) proposta alle imprese italiane (non nel forfettario)
# INVOICE_IBAN=IT00X0000000000000000000000
# INVOICE_BANK=Nome della banca
# INVOICE_B2B_DUE_DAYS=30                          # scadenza delle fatture ai partner
# INVOICE_GIFT_AT=sale                             # sale = buono monouso (fattura alla vendita) · redemption = multiuso (all'utilizzo)
# INVOICE_START_DATE=2027-01-01                    # prima data fatturabile (apertura P.IVA): prenotazioni e fatture precedenti restano fuori dalla coda
# INVOICE_NOTES=                                   # causali separate da | (di default, nel forfettario, i riferimenti di legge)
# Invio a SdI dalla tua casella PEC (facoltativo: senza, scarichi l'XML e lo carichi su «Fatture e Corrispettivi»):
# PEC_SMTP_HOST=smtp.pec.example.it
# PEC_SMTP_PORT=465
# PEC_SMTP_USER=tuonome@pec.example.it
# PEC_SMTP_PASS=
# PEC_SMTP_SECURE=true
# SDI_PEC_ADDRESS=sdi01@pec.fatturapa.it

# ───── Statistiche anonime (facoltative, Umami) ─────
# UMAMI_WEBSITE_ID=
# UMAMI_SRC=https://cloud.umami.is/script.js
